# Railway sets PORT automatically – do not add it yourself.
# Comma-separated list of sites allowed to call the API. Use your Vercel URL(s).
# A * wildcard is allowed inside one name, e.g. https://rwh-planner-*.vercel.app for preview deployments.
ALLOWED_ORIGINS=https://rwh-planner.vercel.app
# Max PDF reports per visitor (IP) per 10 minutes.
REPORT_RATE_LIMIT=20
NODE_ENV=production
# Only needed when running locally outside Docker (path to Chrome/Chromium):
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Live PBS prices (on by default)
PBS_LIVE=on
PBS_CACHE_HOURS=24
# Optional: Google Sheet link shared as 'Anyone with the link – Viewer' (see README)
RATES_SOURCE_URL=
RATES_CACHE_MINUTES=360

# Training videos (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rwh-media
# Optional: public custom domain for the bucket (otherwise signed links are used)
# R2_PUBLIC_URL=

# Admin app
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Long random string (32+ characters); signs sessions and encrypts saved AI keys
SESSION_SECRET=

# AI (any one provider is enough; keys can also be set from the admin)
AI_PROVIDER_ORDER=openai,gemini,openrouter
AI_FALLBACK_ENABLED=true
AI_CACHE_ENABLED=true
AI_CACHE_TTL=3600
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=3
AI_LOGGING=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,meta-llama/llama-3.3-70b-instruct:free
